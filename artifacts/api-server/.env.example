# ============================================================================
# Luna Story API server — environment variables
# ============================================================================
# Local development: copy this file to `.env` (same directory) and fill in real
# values. `.env` is gitignored. The server auto-loads `.env` on startup.
#
# Production (Cloud Run): set these same variables in the Cloud Run service
# config — there is no `.env` file in the deployed image.
# ============================================================================

# --- Core (required) -------------------------------------------------------

# Neon Postgres pooled connection string.
# Neon dashboard -> your project -> Connection Details -> "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Port the API server listens on. Cloud Run injects PORT=8080 automatically;
# this value is only used for local development.
PORT=8080

# --- Soft-lock auth (required) ---------------------------------------------
# Single shared password protecting the whole app until per-user auth ships.
# Anything the team types into the login screen is compared against this.
# Change it any time — existing sessions invalidate automatically on next
# /api/auth/check after the server restarts with a new APP_AUTH_SECRET.
APP_ACCESS_PASSWORD=

# 32+ byte secret used to HMAC-sign access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates all current sessions.
APP_AUTH_SECRET=

# --- Google AI / Gemini (required) -----------------------------------------

# Google AI API key — used for Gemini image generation, Gemini 2.5 Flash
# (VLM analysis + copy suggestions), and Veo 3.1 video generation.
GOOGLE_AI_API_KEY=

# Optional dedicated key for VLM analysis only. Falls back to GOOGLE_AI_API_KEY.
GOOGLE_AI_VLM_API_KEY=

# --- Cloudflare R2 object storage (required) -------------------------------
# Stores all generated images, uploaded references, and generated videos.
# Create an R2 bucket + an R2 API token in the Cloudflare dashboard, and enable
# public access on the bucket (r2.dev subdomain or a custom domain).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lunastory
# Public base URL of the bucket, no trailing slash.
# e.g. https://pub-xxxxxxxx.r2.dev   or   https://cdn.lunastory.synthya.ai
R2_PUBLIC_BASE_URL=
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Video model API keys (optional) ---------------------------------------
# The video studio works without these, but the corresponding model is skipped
# if its key is missing.

RUNWAY_API_KEY=
KLING_API_KEY=
KLING_API_SECRET=

# --- Ecount Open API (Phase 2: inventory bridge) ---------------------------
# Source-of-truth for SKUs/inventory/sales during the bridge period. Values
# from Ecount: 회사코드 (COM_CODE), API user ID, and the API Certificate Key
# generated under Ecount → 자료관리 → API 인증키.

ECOUNT_COM_CODE=
ECOUNT_USER_ID=
ECOUNT_API_CERT_KEY=
# Optional — Ecount has multiple regional servers; ZoneInfo discovers it from
# COM_CODE. Leave blank to auto-discover, or set explicitly (e.g. 'OA') to skip.
ECOUNT_ZONE=
# Optional override of the full base URL (e.g. for testing against a sandbox).
ECOUNT_BASE_URL=
# 'sandbox' (default — sboapi.ecount.com) or 'prod' (oapi.ecount.com).
ECOUNT_ENV=sandbox
# Shared secret for the /api/ecount/sync endpoint. Cloud Scheduler sends this
# as the X-Sync-Secret header. If unset, the endpoint is unauthenticated
# (acceptable for local dev only).
ECOUNT_SYNC_SECRET=
# Comma-separated WH_CD codes to pull inventory snapshots for.
# Set to "200" to mirror 창고별재고현황 (덕영창고) only. Leave empty to sum
# across all warehouses.
ECOUNT_INVENTORY_WAREHOUSES=200
